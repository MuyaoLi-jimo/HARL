        },
        "render":	{
            "render_episodes":	10,
            "use_render":	false
        },
        "seed":	{
            "seed":	1,
            "seed_specify":	true
        },
        "train": {
            "episode_length": 160,
            "eval_interval": 500,
            "train_interval":	50,
            "log_interval": 5,
            "model_dir": null,
            "n_rollout_threads": 100,
            "num_env_steps": 10000000,
            "warmup_steps": 10000,
            "update_per_train": 1,
            "use_linear_lr_decay": false,
            "use_valuenorm": true,
            "use_proper_time_limits": true
        }
    },
    "env_args": {
        "scenario": "MultipleCombat",
        "task": "2v2/ShootMissile/HierarchyVsBaseline",
        "state_type": "EP"
    },
    "main_args": {
        "algo": "hasac",
        "env": "lag",
        "exp_name": "lag-happo-shoot_missile",
        "load_config": ""
    }
