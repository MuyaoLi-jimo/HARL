{
    "algo_args":	{
        "algo":	{
            "alpha":	0.001,
            "alpha_lr":	0.0003,
            "auto_alpha":	true,
            "batch_size":	3000,
            "buffer_size":	1000000,
            "fixed_order":	false,
            "gamma":	0.99,
            "huber_delta":	10.0,
            "n_step":	20,
            "polyak":	0.005,
            "share_param":	false,
            "use_huber_loss":	true,
            "use_policy_active_masks":	true
        },
        "device":	{
            "cuda":	true,
            "cuda_deterministic":	true,
            "torch_threads":	4
        },
        "eval":	{
            "eval_episodes":	40,
            "n_eval_rollout_threads":	20,
            "use_eval":	true
        },
        "logger":	{
            "log_dir":	"./results"
        },
        "model":	{
            "activation_func":	"relu",
            "critic_lr":	0.0025,
            "final_activation_func":	"tanh",
            "gain":	0.01,
            "hidden_sizes":	[
                256,
                256
            ],
            "initialization_method":	"orthogonal_",
